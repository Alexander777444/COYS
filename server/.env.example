# Copy this file to `.env` and replace the placeholder values.
# `.env` is git-ignored; never commit real credentials.

# HTTP port used by the server.
PORT=3000

# SQLite database file, relative to the `server/` folder.
DATABASE_PATH=../database/data/coys.sqlite

# Authentication (used from module M1 onwards). Must be at least 32 characters.
JWT_SECRET=replace-this-with-a-random-secret-32-chars
JWT_EXPIRES_IN=1h
API_USERNAME=admin
API_PASSWORD=change-me
