meta {
  name: LOGIN-401-01 login with a wrong password
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

body:json {
  {
    "username": "{{username}}",
    "password": "definitely-the-wrong-password"
  }
}

assert {
  res.status: eq 401
  res.body.error.code: eq INVALID_CREDENTIALS
  res.body.error.message: eq Invalid username or password
}
