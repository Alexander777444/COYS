meta {
  name: POST-401-01 create without a token
  type: http
  seq: 32
}

post {
  url: {{baseUrl}}/api/v1/projects
  body: json
  auth: none
}

body:json {
  {
    "title": "No Token",
    "slug": "qa-no-token",
    "description": "This body is valid but the request has no token."
  }
}

assert {
  res.status: eq 401
  res.body.error.code: eq MISSING_TOKEN
}
