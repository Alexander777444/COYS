meta {
  name: PUT-404-01 valid body for a UUID that does not exist
  type: http
  seq: 36
}

put {
  url: {{baseUrl}}/api/v1/projects/00000000-0000-4000-8000-0000000000ff
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "title": "Missing Project",
    "slug": "qa-missing-project",
    "description": "The body is valid; the id is not in the table."
  }
}

assert {
  res.status: eq 404
  res.body.error.code: eq NOT_FOUND
  res.body.error.message: contains was not found
}
