meta {
  name: LIST-200-01 list with a valid token and the dev seed
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/api/v1/projects
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

assert {
  res.status: eq 200
  res.body.meta.total: eq 5
  res.body.meta.limit: eq 20
  res.body.meta.offset: eq 0
  res.body.data: isArray
}
