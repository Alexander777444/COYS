meta {
  name: SETUP create the project that DELETE-204-01 removes
  type: http
  seq: 39
}

post {
  url: {{baseUrl}}/api/v1/projects
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "title": "QA Delete Target",
    "slug": "qa-delete-target",
    "description": "Created only to be deleted by DELETE-204-01."
  }
}

script:post-response {
  bru.setVar("deleteId", res.body.id);
}

assert {
  res.status: eq 201
  res.body.id: isString
}
