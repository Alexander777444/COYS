meta {
  name: GET-404-01 valid UUID that does not exist
  type: http
  seq: 18
}

get {
  url: {{baseUrl}}/api/v1/projects/00000000-0000-4000-8000-0000000000ff
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

assert {
  res.status: eq 404
  res.body.error.code: eq NOT_FOUND
  res.body.error.message: contains was not found
}
