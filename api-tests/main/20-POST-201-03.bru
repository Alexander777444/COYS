meta {
  name: POST-201-03 create a project with accents, quotes and SQL text
  type: http
  seq: 23
}

post {
  url: {{baseUrl}}/api/v1/projects
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "title": "Diseño \"Ágil\" y 'calidad' — ñandú",
    "slug": "qa-special-text",
    "description": "Literal text: '; DROP TABLE projects; -- stays inside the column.",
    "technologies": ["Node.js"]
  }
}

script:post-response {
  bru.setVar("specialId", res.body.id);
}

assert {
  res.status: eq 201
  res.body.title: eq Diseño "Ágil" y 'calidad' — ñandú
  res.body.description: contains DROP TABLE projects
  res.body.slug: eq qa-special-text
}
