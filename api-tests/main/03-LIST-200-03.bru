meta {
  name: LIST-200-03 paginate with limit=2 and offset=1
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/api/v1/projects?limit=2&offset=1
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

assert {
  res.status: eq 200
  res.body.meta.total: eq 5
  res.body.meta.limit: eq 2
  res.body.meta.offset: eq 1
  res.body.data[0].id: isString
  res.body.data[1].id: isString
}
