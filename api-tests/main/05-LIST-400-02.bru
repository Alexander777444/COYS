meta {
  name: LIST-400-02 limit is below the minimum
  type: http
  seq: 8
}

get {
  url: {{baseUrl}}/api/v1/projects?limit=0
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

assert {
  res.status: eq 400
  res.body.error.code: eq VALIDATION_ERROR
  res.body.error.details[0].path: eq limit
}
