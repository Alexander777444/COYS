meta {
  name: POST-201-02 create a project with only the required fields
  type: http
  seq: 22
}

post {
  url: {{baseUrl}}/api/v1/projects
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "title": "QA Defaults",
    "slug": "qa-defaults",
    "description": "Only the required fields are sent."
  }
}

script:post-response {
  bru.setVar("defaultsId", res.body.id);
}

assert {
  res.status: eq 201
  res.body.clientName: isNull
  res.body.technologies: isEmpty
  res.body.projectUrl: isNull
  res.body.repositoryUrl: isNull
  res.body.status: eq DRAFT
}
