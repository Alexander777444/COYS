meta {
  name: 00-login obtain a token for the rest of the run
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

body:json {
  {
    "username": "{{username}}",
    "password": "{{password}}"
  }
}

script:post-response {
  bru.setVar("token", res.body.token);
}

assert {
  res.status: eq 200
  res.body.tokenType: eq Bearer
}
