meta {
  name: GET-200-01 get the first seed project
  type: http
  seq: 15
}

get {
  url: {{baseUrl}}/api/v1/projects/00000000-0000-4000-8000-000000000001
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

assert {
  res.status: eq 200
  res.body.id: eq 00000000-0000-4000-8000-000000000001
  res.body.slug: eq portfolio-website
  res.body.title: eq Portfolio Website
  res.body.status: eq PUBLISHED
  res.body.technologies: isArray
  res.body.createdAt: isString
  res.body.updatedAt: isString
}
