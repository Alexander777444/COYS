meta {
  name: DELETE-404-01 delete the same project twice
  type: http
  seq: 43
}

delete {
  url: {{baseUrl}}/api/v1/projects/{{deleteId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

assert {
  res.status: eq 404
  res.body.error.code: eq NOT_FOUND
  res.body.error.message: contains was not found
}
