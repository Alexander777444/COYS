meta {
  name: POST-400-03 projectUrl is not an http(s) URL
  type: http
  seq: 26
}

post {
  url: {{baseUrl}}/api/v1/projects
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "title": "Bad URL",
    "slug": "qa-bad-url",
    "description": "The project URL uses the ftp scheme.",
    "projectUrl": "ftp://example.com/project"
  }
}

assert {
  res.status: eq 400
  res.body.error.code: eq VALIDATION_ERROR
  res.body.error.details[0].path: eq projectUrl
}
