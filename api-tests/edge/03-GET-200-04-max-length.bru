meta {
  name: GET-200-04 edge seed with maximum-length fields
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/api/v1/projects/00000000-0000-4000-8000-000000000103
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

script:post-response {
  test("title is 150 characters", function () {
    expect(res.body.title.length).to.equal(150);
  });
  test("description is 5000 characters", function () {
    expect(res.body.description.length).to.equal(5000);
  });
}

assert {
  res.status: eq 200
  res.body.slug: eq max-length-fields
}
