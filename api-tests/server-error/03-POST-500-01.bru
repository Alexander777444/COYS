meta {
  name: POST-500-01 create with the projects table dropped
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/v1/projects
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "title": "Broken Database",
    "slug": "qa-broken-database",
    "description": "The body is valid; the table is missing."
  }
}

script:post-response {
  test("no SQL is leaked", function () {
    expect(JSON.stringify(res.body)).to.not.contain("no such table");
  });
}

assert {
  res.status: eq 500
  res.body.error.code: eq INTERNAL_ERROR
  res.body.error.message: eq Unexpected server error
  res.body.error.details: isNull
}
